# Server Binding
BIND_HOST=0.0.0.0
HTTP_PORT=8080
SOCKS5_PORT=1080

# Authentication Mode (true = require username/password, false = open proxy)
AUTH_REQUIRED=true

# Primary Authentication Credentials (ignored if AUTH_REQUIRED=false)
PROXY_USER=admin
PROXY_PASS=ChangeThisSecurePassword123!

# Optional: Multiple users (comma-separated username:password pairs)
# Takes precedence or appends to primary credentials
# PROXY_USERS=admin:ChangeThisSecurePassword123!,client2:AnotherSecurePass456!

# Optional: Restrict access to specific client IP addresses (comma-separated)
# Leave blank to allow connections from any client IP that provides valid credentials
# ALLOWED_IPS=203.0.113.42,198.51.100.15

# Logging level: info | debug | error | silent
LOG_LEVEL=info
